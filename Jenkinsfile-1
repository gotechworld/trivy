pipeline {
  agent { label 'linux' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
  stages {
    stage('Pull') {
      steps {
        sh 'docker pull petrugiurca/axsys-golang-v1.18:latest'
      }
    }
    stage('Scan') {
      steps {
        sh 'trivy petrugiurca/axsys-golang-v1.18:latest'
      }
    }
  }
}
