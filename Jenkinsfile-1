pipeline {
  agent { label 'linux' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
  stages {
    stage('Sign in') {
      steps {
        sh 'docker login'
      }
    }
    stage('Pull') {
      steps {
        sh 'docker pull petrugiurca/axsys-golang-v1.18:latest'
      }
    }
    stage('Scan') {
      steps {
        sh 'trivy image petrugiurca/axsys-golang-v1.18:latest'
      }
    }
    stage('Clean') {
      steps {
        sh 'docker images -q | xargs docker rmi -f'
      }
    }
  }
}
