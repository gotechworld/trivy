pipeline {
  agent { label 'linux' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
  stages {
    stage('Build') {
      steps {
        sh 'docker build --no-cache -t petrugiurca/axsys-golang-v1.18:latest .'
      }
    }
    stage('Scan') {
      steps {
        sh 'trivy --no-progress --exit-code 1 --severity HIGH,CRITICAL petrugiurca/axsys-golang-v1.18:latest'
      }
    }
  }
}
